<Controller Use="Context" Name="ALDOX_CA0104">
<DataTypes Use="Context">
</DataTypes>
<Tags Use="Context">
<Tag Name="FC11_HOLD" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data>00</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="FC11_OUT_MEM" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data>00 00 C8 41</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="25.0"/>
</Data>
</Tag>
