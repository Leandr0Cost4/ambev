<Tags Use="Context">
<Tag Name="LC21_FF_GAIN" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data>9A 99 19 3E</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.15"/>
</Data>
</Tag>
</Tags>
<Programs Use="Context">
<Program Use="Context" Name="Continuous">
<Routines Use="Context">
<Routine Use="Context" Name="Lad_099_Controllers" Type="RLL">
<RLLContent Use="Context">
<Rung Use="Target" Number="25" Type="N">
<Comment>
<![CDATA[TESTE test_bits.1 - LC21 FEEDFORWARD: no passo 115, a velocidade da bomba B421507 P21 = saida da LC21 + ganho x (vazao FT11 - setpoint FC11). Com a vazao no setpoint a correcao e zero; se a alimentacao for cortada a P21 desacelera na hora. Nao mexe na PID (BIAS continua 0).]]>
</Comment>
<Text>
<![CDATA[XIC(test_bits.1)XIC(M_115_FORWARD_FLOW_PROD)XIO(M_LC21_MAN)XIO(control_b421507_pid_off)CPT(SP_P21,LC21.OUT+LC21_FF_GAIN*(INLET_FT11-FC11.SP));]]>
</Text>
</Rung>
<Rung Use="Target" Number="26" Type="N">
<Comment>
<![CDATA[TESTE test_bits.1 - LC21 FEEDFORWARD: limita a velocidade da P21 entre 0 e 100 %.]]>
</Comment>
<Text>
<![CDATA[XIC(test_bits.1)XIC(M_115_FORWARD_FLOW_PROD)[GRT(SP_P21,100.0) MOV(100.0,SP_P21) ,LES(SP_P21,0.0) MOV(0.0,SP_P21) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
